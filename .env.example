# Database Connection (Supabase PostgreSQL with Pooler & Direct URL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Free Gemini API Key (Opsional: jika diisi menggunakan Gemini Vision AI, jika kosong otomatis menggunakan engine lokal)
GEMINI_API_KEY=""

# Outbound Webhook Target (Simulasi sistem kasir / ERP internal)
DISBURSEMENT_WEBHOOK_URL="http://localhost:3000/api/webhook/finance/disbursement"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
