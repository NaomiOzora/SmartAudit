# Database Connection (Default SQLite zero-config)
DATABASE_URL="file:./dev.db"

# Free Gemini API Key (Optional: jika diisi, sistem menggunakan Gemini 1.5 Flash untuk OCR & XAI live; jika kosong, sistem menggunakan engine simulasi forensik cerdas bawaan)
GEMINI_API_KEY=""

# Outbound Webhook Target (Simulasi sistem kasir/ERP internal)
DISBURSEMENT_WEBHOOK_URL="http://localhost:3000/api/webhook/finance/disbursement"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
